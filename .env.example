# Root (monorepo) environment variables.
#
# Copy to `.env` at the repo root for local dev.
# The root `.env` is loaded by the server via dotenv.

# Server
PORT=3001

# Gemini (server-side AI coaching)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Firebase (server-side token verification; optional unless you enable server auth)
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"

# Client (Vite)
# When true, allows demo flow without OTP (for hackathon judging).
VITE_DEMO_BYPASS_AUTH=false

# When true, exposes /admin route.
VITE_ENABLE_ADMIN_ROUTE=false

# Optional (used only if you deploy behind a known URL)
APP_URL="MY_APP_URL"
