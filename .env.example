# Server environment variables
# Copy this file to `server/.env` for local development using the server package.

# Backend port (optional, defaults to 3001)
PORT="3001"

# Gemini API key for server-side coaching generation
# Get it from: https://ai.google.dev/
# Without this, the app falls back to heuristic coaching suggestions.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Enable the /admin route in the client.
VITE_ENABLE_ADMIN_ROUTE="false"

# Optional app URL for hosting or OAuth callbacks.
APP_URL="http://localhost:3001"

